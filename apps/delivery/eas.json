{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_API_BASE_URL": "http://10.0.2.2:8082",
        "EXPO_PUBLIC_WS_URL": "ws://10.0.2.2:8082/ws"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_API_BASE_URL": "https://api-preview.foodie.example.com",
        "EXPO_PUBLIC_WS_URL": "wss://api-preview.foodie.example.com/ws"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.foodie.kwiko.org",
        "EXPO_PUBLIC_WS_URL": "wss://api.foodie.kwiko.org/ws"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
