# ===================================================================
# Foodie Delivery Partner Mobile App - Environment Configuration
# ===================================================================
#
# NOTE: In Expo React Native, ONLY variables prefixed with EXPO_PUBLIC_*
# are exposed to client JavaScript at build time.
#
# DO NOT add backend private secrets (e.g. database passwords, private API
# keys, payment gateway secret keys, JWT secret keys) to this file or prefix
# them with EXPO_PUBLIC_*.

# -------------------------------------------------------------------
# 1. API & WebSocket URLs (Dynamic Public Endpoints)
# -------------------------------------------------------------------
# Local Development: http://localhost:8082 or http://10.0.2.2:8082 (Android Emulator)
# Preview / Staging:  https://api-preview.yourdomain.com
# Production:         https://api.foodie.kwiko.org
EXPO_PUBLIC_API_BASE_URL=http://localhost:8082

# WebSocket URL for real-time delivery notifications and order offers
# (If omitted, automatically derived from EXPO_PUBLIC_API_BASE_URL)
EXPO_PUBLIC_WS_URL=ws://localhost:8082/ws

# -------------------------------------------------------------------
# 2. App Environment
# -------------------------------------------------------------------
# Options: development | preview | production
APP_ENV=development

# -------------------------------------------------------------------
# 3. EAS Build Project ID (Set via EAS CLI or expo.dev dashboard)
# -------------------------------------------------------------------
# EAS_PROJECT_ID=00000000-0000-0000-0000-000000000001
