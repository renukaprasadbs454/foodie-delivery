# Foodie Delivery - Environment Variables

# The base URL of the backend REST API
EXPO_PUBLIC_API_BASE_URL=https://api.foodie.kwiko.org

# The WebSocket URL for real-time features (Stomp/WebSockets)
EXPO_PUBLIC_WS_URL=wss://api.foodie.kwiko.org/ws

# Application Environment (development, preview, production)
NODE_ENV=development
